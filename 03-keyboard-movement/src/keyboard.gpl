* Simple GPL demo of keyboard movement
        GROM >6000
        AORG >0000

* Cartridge header
        DATA >AA01         * Valid cartridge
        DATA >0000
        DATA >0000
        DATA MENU          * Pointer to menu
        DATA 0,0,0,0

MENU    DATA 0
        DATA START
        STRI 'KEYBOARD'
        BSS 0

START
        ALL >20             ; Clear screen
        BACK >14            ; Green background

        ST >1F,@>8300
        ST >20,@>8301
        DST >0380,@>8302
        
FILLCLR
        MOVE 1,@>8300,V*>8302
        DINC @>8302
        DEC @>8301
        BR FILLCLR

; === VDP registers ===
        ST >00,@>83D0
        MOVE 1,@>83D0,#0    ; Reg 0 = Graphics mode

        ST >E2,@>83D4       ; Reg 1 = 16x16 + display on
        MOVE 1,@>83D4,#1

        ST >06,@>83DA
        MOVE 1,@>83DA,#5    ; Reg 5 = SAT at >0300

        ST >00,@>83DC
        MOVE 1,@>83DC,#6    ; Reg 6 = Sprite patterns at >0000 base

; Copy rectangle outline pattern (32 bytes for 16x16 magnified)
        MOVE 32,G@GFXDATA,V@>0400

; Sprite Attribute Table
        MOVE 4,G@SPRATTR,V@>0300   ; Copy sprite attributes to VDP
        MOVE 2,G@SPRATTR,@>8301    ; Copy X/Y into RAM 

        FMT
        COL 6
        ROW 12
        HTEX 'USE W,A,S,D TO MOVE!'
        FEND

        ST >03,@>8374
        CLR @>83C8

WAITVBL
        ST @>837B,@>8300           ; Read VDP status byte
        CLOG >80,@>8300            ; Test if bit 7 is set
        BS WAITVBL                 ; Wait if no interrupt

        ST >00,@>837B              ; Clear VDP status byte

        MOVE 2,@>8301,V@>0300      ; Push Y/X to VDP

        ; Scan the keyboard
        SCAN

        ; Check for the A key
        CEQ >41,@>8375
        BS MOVELEFT

        ; Check for the D key
        CEQ >44,@>8375
        BS MOVERIGHT

        ; Check for the W key
        CEQ >57,@>8375
        BS MOVEUP

        ; Check for the S key
        CEQ >53,@>8375
        BS MOVEDOWN

        B WAITVBL

MOVELEFT
        DEC @>8302
        B WAITVBL

MOVERIGHT
        INC @>8302
        B WAITVBL

MOVEUP
        DEC @>8301
        B WAITVBL

MOVEDOWN
        INC @>8301
        B WAITVBL

; ========================
; Data
; ========================
GFXDATA
        BYTE >FF,>81,>81,>81,>81,>81,>81,>FF   ; Top + sides + bottom
        BYTE >FF,>81,>81,>81,>81,>81,>81,>FF   ; repeated for the other 3 chars
        BYTE >FF,>81,>81,>81,>81,>81,>81,>FF
        BYTE >FF,>81,>81,>81,>81,>81,>81,>FF

SPRATTR
        BYTE >10,>7A,>80,>0A   ; Sprite 0: Y=10, X=3C, Pattern >80, Color 4 (dark blue)